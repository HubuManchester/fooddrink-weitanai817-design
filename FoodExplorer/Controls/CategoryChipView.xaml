<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="FoodExplorer.Controls.CategoryChipView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:FoodExplorer.Models"
    x:DataType="models:RecipeCategory">

    <ContentView.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="../Resources/Styles/Typography.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentView.Resources>

    <Border
        BackgroundColor="{Binding BackgroundColor}"
        HeightRequest="100"
        MinimumHeightRequest="44"
        MinimumWidthRequest="120"
        Padding="16"
        StrokeThickness="0"
        StrokeShape="RoundRectangle 16"
        WidthRequest="140">
        <Border.GestureRecognizers>
            <TapGestureRecognizer
                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentView}}, Path=TapCommand}"
                CommandParameter="{Binding Source={RelativeSource AncestorType={x:Type ContentView}}, Path=TapCommandParameter}" />
        </Border.GestureRecognizers>

        <VerticalStackLayout Spacing="4" VerticalOptions="Center">
            <Label
                FontSize="28"
                HorizontalOptions="Center"
                Text="{Binding IconEmoji}"
                SemanticProperties.Description="{Binding Name, StringFormat='{0} category'}" />
            <Label
                FontFamily="OpenSansSemibold"
                FontSize="14"
                HorizontalOptions="Center"
                Text="{Binding Name}"
                TextColor="{StaticResource White}" />
            <Label
                FontSize="11"
                HorizontalOptions="Center"
                Text="{Binding RecipeCount, StringFormat='{0} recipes'}"
                TextColor="#CCFFFFFF" />
        </VerticalStackLayout>
    </Border>

</ContentView>
