<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="FoodExplorer.Views.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:FoodExplorer.Controls"
    xmlns:models="clr-namespace:FoodExplorer.Models"
    xmlns:vm="clr-namespace:FoodExplorer.ViewModels"
    xmlns:converters="clr-namespace:FoodExplorer.Converters"
    Title="{Binding Title}"
    x:DataType="vm:HomeViewModel"
    BackgroundColor="{AppThemeBinding Light=#FFF8F5, Dark=#1A1A2E}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="../Resources/Styles/Typography.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:DifficultyToColorConverter x:Key="DifficultyToColorConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="24">

            <!-- Hero header -->
            <VerticalStackLayout Spacing="8">
                <Label
                    FontFamily="OpenSansSemibold"
                    FontSize="28"
                    Text="🍜 FoodExplorer"
                    SemanticProperties.HeadingLevel="Level1" />
                <Label
                    FontSize="16"
                    Text="Discover, cook, and savour amazing recipes"
                    TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
            </VerticalStackLayout>

            <!-- Featured recipes -->
            <VerticalStackLayout Spacing="12">
                <Grid ColumnDefinitions="*,Auto">
                    <Label
                        Grid.Column="0"
                        Style="{StaticResource TitleSmall}"
                        Text="Featured Recipes"
                        SemanticProperties.HeadingLevel="Level2" />
                    <Button
                        Grid.Column="1"
                        BackgroundColor="Transparent"
                        Command="{Binding BrowseAllCommand}"
                        FontSize="14"
                        MinimumHeightRequest="44"
                        Text="See all →"
                        TextColor="{StaticResource Primary}"
                        SemanticProperties.Description="Browse all recipes" />
                </Grid>

                <ActivityIndicator
                    IsRunning="{Binding IsBusy}"
                    IsVisible="{Binding IsBusy}"
                    Color="{StaticResource Primary}" />

                <CollectionView
                    HeightRequest="260"
                    ItemsSource="{Binding FeaturedRecipes}"
                    SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout ItemSpacing="16" Orientation="Horizontal" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Recipe">
                            <Border
                                BackgroundColor="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}"
                                HeightRequest="240"
                                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                                StrokeShape="RoundRectangle 16"
                                WidthRequest="200">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenRecipeCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                                <Grid RowDefinitions="120,*">
                                    <Image
                                        Grid.Row="0"
                                        Aspect="AspectFill"
                                        Source="{Binding ImageUri}"
                                        SemanticProperties.Description="{Binding Name, StringFormat='Photo of {0}'}" />
                                    <VerticalStackLayout Grid.Row="1" Padding="12" Spacing="4">
                                        <Label
                                            FontFamily="OpenSansSemibold"
                                            FontSize="14"
                                            LineBreakMode="TailTruncation"
                                            MaxLines="1"
                                            Text="{Binding Name}" />
                                        <Label
                                            FontSize="12"
                                            Text="{Binding TotalTimeDisplay}"
                                            TextColor="{StaticResource Primary}" />
                                        <Label
                                            FontSize="12"
                                            Text="{Binding RatingDisplay}"
                                            TextColor="{StaticResource AccentDark}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <!-- Categories -->
            <VerticalStackLayout Spacing="12">
                <Label
                    Style="{StaticResource TitleSmall}"
                    Text="Categories"
                    SemanticProperties.HeadingLevel="Level2" />

                <CollectionView
                    HeightRequest="110"
                    ItemsSource="{Binding Categories}"
                    SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout ItemSpacing="12" Orientation="Horizontal" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:RecipeCategory">
                            <controls:CategoryChipView
                                Category="{Binding .}"
                                TapCommand="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenCategoryCommand}"
                                TapCommandParameter="{Binding .}" />
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <!-- Shake-to-random (Accelerometer) -->
            <Border
                BackgroundColor="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}"
                Padding="16"
                Stroke="{StaticResource Accent}"
                StrokeShape="RoundRectangle 12"
                StrokeThickness="1">
                <VerticalStackLayout Spacing="10">
                    <Label
                        FontFamily="OpenSansSemibold"
                        FontSize="16"
                        Text="🎲 Shake for Surprise"
                        SemanticProperties.HeadingLevel="Level2" />
                    <Label
                        FontSize="13"
                        Text="{Binding ShakeHint}"
                        TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                    <Button
                        Command="{Binding RandomRecipeCommand}"
                        MinimumHeightRequest="44"
                        Style="{StaticResource PrimaryButton}"
                        Text="Pick Random Recipe"
                        SemanticProperties.Description="Pick a random recipe without shaking" />
                </VerticalStackLayout>
            </Border>

            <!-- Quick actions -->
            <Button
                Command="{Binding BrowseAllCommand}"
                Style="{StaticResource PrimaryButton}"
                Text="Explore All Recipes"
                SemanticProperties.Description="Open the full recipe list" />

            <Button
                BackgroundColor="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}"
                BorderColor="{StaticResource Primary}"
                BorderWidth="1"
                Command="{Binding BrowseFavouritesCommand}"
                MinimumHeightRequest="44"
                Text="♥ My Favourites"
                TextColor="{StaticResource Primary}"
                SemanticProperties.Description="Browse favourite recipes" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
