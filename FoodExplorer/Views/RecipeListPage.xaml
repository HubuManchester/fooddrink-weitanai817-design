<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="FoodExplorer.Views.RecipeListPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:FoodExplorer.Controls"
    xmlns:models="clr-namespace:FoodExplorer.Models"
    xmlns:vm="clr-namespace:FoodExplorer.ViewModels"
    xmlns:converters="clr-namespace:FoodExplorer.Converters"
    Title="{Binding Title}"
    x:DataType="vm:RecipeListViewModel"
    BackgroundColor="{AppThemeBinding Light=#FFF8F5, Dark=#1A1A2E}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="../Resources/Styles/Typography.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <converters:StringNotEmptyConverter x:Key="StringNotEmptyConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid Padding="16">

        <Grid
            x:Name="ContentGrid"
            RowDefinitions="Auto,Auto,Auto,Auto,Auto,*"
            RowSpacing="10">

        <!-- Search + voice -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <SearchBar
                Grid.Column="0"
                Placeholder="Search recipes…"
                SearchButtonPressed="OnSearchBarSearchButtonPressed"
                Text="{Binding SearchQuery}"
                MinimumHeightRequest="44"
                SemanticProperties.Description="Search recipes by name, category, or cuisine" />
            <Button
                Grid.Column="1"
                BackgroundColor="{StaticResource Secondary}"
                Command="{Binding VoiceSearchCommand}"
                CornerRadius="22"
                FontSize="18"
                HeightRequest="44"
                IsEnabled="{Binding IsListening, Converter={StaticResource InvertedBoolConverter}}"
                MinimumHeightRequest="44"
                MinimumWidthRequest="44"
                Text="🎤"
                WidthRequest="44"
                SemanticProperties.Description="Voice search using microphone" />
        </Grid>

        <!-- Filters -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Picker
                Grid.Column="0"
                ItemsSource="{Binding DifficultyOptions}"
                SelectedItem="{Binding SelectedDifficulty}"
                Title="Difficulty"
                MinimumHeightRequest="44"
                SemanticProperties.Description="Filter by difficulty level" />
            <HorizontalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                <Label
                    FontSize="13"
                    Text="♥ Only"
                    VerticalOptions="Center" />
                <Switch
                    IsToggled="{Binding ShowFavouritesOnly}"
                    MinimumHeightRequest="44"
                    SemanticProperties.Description="Show favourites only" />
            </HorizontalStackLayout>
        </Grid>

        <!-- Validation message -->
        <Border
            Grid.Row="2"
            BackgroundColor="{StaticResource Error}"
            IsVisible="{Binding HasValidationMessage}"
            Padding="12,8"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 8">
            <Label
                FontSize="13"
                Text="{Binding ValidationMessage}"
                TextColor="{StaticResource White}" />
        </Border>

        <!-- Result count + actions -->
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto">
            <Label
                Grid.Column="0"
                FontSize="14"
                Text="{Binding ResultCountText}"
                TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                VerticalOptions="Center" />
            <Button
                Grid.Column="1"
                BackgroundColor="Transparent"
                Command="{Binding ClearSearchCommand}"
                FontSize="14"
                IsVisible="{Binding SearchQuery, Converter={StaticResource StringNotEmptyConverter}}"
                MinimumHeightRequest="44"
                Text="Clear"
                TextColor="{StaticResource Primary}"
                SemanticProperties.Description="Clear search query" />
            <Button
                Grid.Column="2"
                BackgroundColor="Transparent"
                Command="{Binding ClearFiltersCommand}"
                FontSize="14"
                MinimumHeightRequest="44"
                Text="Reset"
                TextColor="{StaticResource Primary}"
                SemanticProperties.Description="Reset all filters" />
        </Grid>

        <ActivityIndicator
            Grid.Row="4"
            HorizontalOptions="Center"
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}"
            VerticalOptions="Center"
            Color="{StaticResource Primary}" />

        <ActivityIndicator
            Grid.Row="4"
            HorizontalOptions="Center"
            IsRunning="{Binding IsListening}"
            IsVisible="{Binding IsListening}"
            VerticalOptions="Center"
            Color="{StaticResource Secondary}" />

        <RefreshView
            Grid.Row="5"
            Command="{Binding RefreshCommand}"
            IsRefreshing="{Binding IsRefreshing}">
        <CollectionView
            x:Name="RecipeCollection"
            IsVisible="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
            ItemsSource="{Binding Recipes}"
            SelectionMode="None">
            <CollectionView.ItemsLayout>
                <GridItemsLayout HorizontalItemSpacing="12" Orientation="Vertical" Span="{Binding GridSpan}" VerticalItemSpacing="12" />
            </CollectionView.ItemsLayout>
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" Padding="40" Spacing="12" VerticalOptions="Center">
                    <Label
                        FontSize="48"
                        HorizontalOptions="Center"
                        Text="🍽️" />
                    <Label
                        FontFamily="OpenSansSemibold"
                        FontSize="18"
                        HorizontalTextAlignment="Center"
                        Text="No recipes found"
                        SemanticProperties.HeadingLevel="Level2" />
                    <Label
                        FontSize="14"
                        HorizontalTextAlignment="Center"
                        Text="Try adjusting your search, filters, or browse all categories"
                        TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:RecipeSummary">
                    <controls:RecipeCardView
                        FavouriteCommand="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ToggleFavouriteCommand}"
                        Recipe="{Binding .}"
                        TapCommand="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenRecipeCommand}"
                        TapCommandParameter="{Binding .}" />
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        </RefreshView>

        </Grid>

    </Grid>

</ContentPage>
