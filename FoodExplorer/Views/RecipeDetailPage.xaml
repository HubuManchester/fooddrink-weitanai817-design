<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="FoodExplorer.Views.RecipeDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:FoodExplorer.Controls"
    xmlns:models="clr-namespace:FoodExplorer.Models"
    xmlns:vm="clr-namespace:FoodExplorer.ViewModels"
    xmlns:converters="clr-namespace:FoodExplorer.Converters"
    Title="{Binding Title}"
    x:DataType="vm:RecipeDetailViewModel"
    BackgroundColor="{AppThemeBinding Light=#FFF8F5, Dark=#1A1A2E}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="../Resources/Styles/Typography.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:BoolToHeartConverter x:Key="BoolToHeartConverter" />
            <converters:IsNotNullConverter x:Key="IsNotNullConverter" />
            <converters:StepHighlightConverter x:Key="StepHighlightConverter" />
            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <converters:StringNotEmptyConverter x:Key="StringNotEmptyConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <ActivityIndicator
            HorizontalOptions="Center"
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}"
            VerticalOptions="Center"
            Color="{StaticResource Primary}" />

        <ScrollView IsVisible="{Binding Recipe, Converter={StaticResource IsNotNullConverter}}">
            <VerticalStackLayout x:Name="DetailContent" Spacing="0">

                <Grid>
                    <controls:CachedImageView
                        HeightRequest="240"
                        HorizontalOptions="Fill"
                        VerticalOptions="Fill"
                        ImageFileName="{Binding Recipe.ImageUri}"
                        SemanticProperties.Description="{Binding Recipe.Name, StringFormat='Photo of {0}'}" />

                    <Button
                        BackgroundColor="#80000000"
                        Command="{Binding ToggleFavouriteCommand}"
                        CornerRadius="22"
                        HeightRequest="44"
                        HorizontalOptions="End"
                        Margin="16"
                        MinimumHeightRequest="44"
                        MinimumWidthRequest="44"
                        Text="{Binding Recipe.IsFavourite, Converter={StaticResource BoolToHeartConverter}}"
                        VerticalOptions="Start"
                        WidthRequest="44"
                        SemanticProperties.Description="Toggle favourite" />
                </Grid>

                <VerticalStackLayout Padding="20" Spacing="16">

                    <VerticalStackLayout Spacing="8">
                        <Label
                            FontFamily="OpenSansSemibold"
                            FontSize="24"
                            Text="{Binding Recipe.Name}"
                            SemanticProperties.HeadingLevel="Level1" />
                        <Label
                            FontSize="14"
                            Text="{Binding Recipe.FullDescription}"
                            TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                        <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="8">
                            <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                                <Label FontSize="11" HorizontalOptions="Center" Text="Time" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                <Label FontFamily="OpenSansSemibold" FontSize="14" HorizontalOptions="Center" Text="{Binding Recipe.TotalTimeDisplay}" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource CardBorder}" Padding="8">
                            <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                                <Label FontSize="11" HorizontalOptions="Center" Text="Servings" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                <Label FontFamily="OpenSansSemibold" FontSize="14" HorizontalOptions="Center" Text="{Binding Recipe.Servings}" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="8">
                            <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                                <Label FontSize="11" HorizontalOptions="Center" Text="Calories" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                <Label FontFamily="OpenSansSemibold" FontSize="14" HorizontalOptions="Center" Text="{Binding Recipe.CaloriesPerServing}" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="3" Style="{StaticResource CardBorder}" Padding="8">
                            <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                                <Label FontSize="11" HorizontalOptions="Center" Text="Rating" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                <Label FontFamily="OpenSansSemibold" FontSize="14" HorizontalOptions="Center" Text="{Binding Recipe.RatingDisplay}" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <HorizontalStackLayout
                        BindableLayout.ItemsSource="{Binding Recipe.DietaryTags}"
                        Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Border
                                    BackgroundColor="{StaticResource Secondary}"
                                    Padding="10,4"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12">
                                    <Label FontSize="12" Text="{Binding .}" TextColor="{StaticResource White}" />
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>

                    <!-- Camera: capture your dish (Hardware #1) -->
                    <VerticalStackLayout Spacing="10">
                        <Label Style="{StaticResource TitleSmall}" Text="My Dish Photo" SemanticProperties.HeadingLevel="Level2" />
                        <Border
                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}"
                            HeightRequest="180"
                            Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                            StrokeShape="RoundRectangle 12"
                            StrokeThickness="1">
                            <Grid>
                                <Label
                                    HorizontalOptions="Center"
                                    Text="📷 No photo yet"
                                    TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                                    VerticalOptions="Center" />
                                <Image
                                    Aspect="AspectFill"
                                    IsVisible="{Binding CapturedPhoto, Converter={StaticResource IsNotNullConverter}}"
                                    Source="{Binding CapturedPhoto}"
                                    SemanticProperties.Description="Photo of your cooked dish" />
                            </Grid>
                        </Border>
                        <Button
                            Command="{Binding CapturePhotoCommand}"
                            MinimumHeightRequest="44"
                            Style="{StaticResource PrimaryButton}"
                            Text="📷 Capture Dish Photo"
                            SemanticProperties.Description="Take a photo of your dish using the camera" />
                        <Border
                            BackgroundColor="{StaticResource Secondary}"
                            IsVisible="{Binding HasPhotoStatus}"
                            Padding="10,6"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 8">
                            <Label
                                FontSize="13"
                                Text="{Binding PhotoStatusMessage}"
                                TextColor="{StaticResource White}" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Label Style="{StaticResource TitleSmall}" Text="Ingredients" SemanticProperties.HeadingLevel="Level2" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Recipe.Ingredients}" Spacing="6">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:Ingredient">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                        <Label Grid.Column="0" Text="•" TextColor="{StaticResource Primary}" />
                                        <Label
                                            Grid.Column="1"
                                            FontSize="14"
                                            Text="{Binding DisplayText}"
                                            SemanticProperties.Description="{Binding DisplayText, StringFormat='Ingredient: {0}'}" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Label Style="{StaticResource TitleSmall}" Text="Instructions" SemanticProperties.HeadingLevel="Level2" />

                        <!-- TTS + Compass (Hardware #4 & #5) -->
                        <Border
                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}"
                            Padding="12"
                            Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                            StrokeShape="RoundRectangle 12"
                            StrokeThickness="1">
                            <VerticalStackLayout Spacing="8">
                                <Label
                                    FontSize="13"
                                    Text="{Binding CompassDisplay}"
                                    TextColor="{StaticResource Secondary}" />
                                <Label
                                    FontSize="12"
                                    Text="{Binding SensorHint}"
                                    TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <Button
                                        Grid.Column="0"
                                        Command="{Binding NarrateRecipeCommand}"
                                        IsEnabled="{Binding IsNarrating, Converter={StaticResource InvertedBoolConverter}}"
                                        MinimumHeightRequest="44"
                                        Text="🔊 Read Aloud"
                                        SemanticProperties.Description="Read recipe instructions aloud using text to speech" />
                                    <Button
                                        Grid.Column="1"
                                        Command="{Binding StopNarrationCommand}"
                                        MinimumHeightRequest="44"
                                        Text="⏹ Stop"
                                        SemanticProperties.Description="Stop text to speech narration" />
                                </Grid>
                                <Label
                                    FontSize="12"
                                    IsVisible="{Binding NarrationStatusMessage, Converter={StaticResource StringNotEmptyConverter}}"
                                    Text="{Binding NarrationStatusMessage}"
                                    TextColor="{StaticResource Primary}" />
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <Button
                                        Grid.Column="0"
                                        Command="{Binding PreviousStepCommand}"
                                        MinimumHeightRequest="44"
                                        Text="◀ Prev Step"
                                        SemanticProperties.Description="Go to previous instruction step" />
                                    <Button
                                        Grid.Column="1"
                                        Command="{Binding NextStepCommand}"
                                        MinimumHeightRequest="44"
                                        Text="Next Step ▶"
                                        SemanticProperties.Description="Go to next instruction step" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding InstructionSteps}" Spacing="12">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:InstructionStep">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                        <Border
                                            Grid.Column="0"
                                            BackgroundColor="{Binding IsCurrent, Converter={StaticResource StepHighlightConverter}}"
                                            HeightRequest="28"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 14"
                                            VerticalOptions="Start"
                                            WidthRequest="28">
                                            <Label
                                                FontFamily="OpenSansSemibold"
                                                FontSize="12"
                                                HorizontalOptions="Center"
                                                Text="{Binding Number}"
                                                TextColor="{StaticResource White}"
                                                VerticalOptions="Center" />
                                        </Border>
                                        <Label
                                            Grid.Column="1"
                                            FontSize="14"
                                            Text="{Binding Text}"
                                            TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <!-- Location: find nearby restaurants (Hardware #9 — Geolocation) -->
                    <VerticalStackLayout Spacing="10">
                        <Label
                            Style="{StaticResource TitleSmall}"
                            Text="📍 Nearby Restaurants"
                            SemanticProperties.HeadingLevel="Level2" />
                        <Button
                            Command="{Binding FindNearbyRestaurantsCommand}"
                            MinimumHeightRequest="44"
                            Style="{StaticResource PrimaryButton}"
                            Text="📍 Find Nearby Restaurants"
                            SemanticProperties.Description="Use your location to find nearby restaurants serving this cuisine" />
                        <Border
                            BackgroundColor="{StaticResource Secondary}"
                            IsVisible="{Binding HasLocationStatus}"
                            Padding="10,8"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 8">
                            <Label
                                FontSize="13"
                                Text="{Binding LocationStatusMessage}"
                                TextColor="{StaticResource White}" />
                        </Border>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
